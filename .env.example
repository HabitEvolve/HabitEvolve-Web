# Copy this file to .env at the REPO ROOT (not src/) — Vite's default envDir is
# the project root, so a .env inside src/ is silently ignored.
#
#   cp .env.example .env
#
# .env is gitignored; this template is committed.

# ── Backend ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://habitevolve-be-2.onrender.com/api

# ── Supabase ──────────────────────────────────────────────────────────────────
# 'true' → use the in-memory mock (src/api/supabaseClient.mock.ts): no network, no
# credentials needed. Google sign-in is faked locally and avatar uploads resolve to
# temporary blob URLs. Set to 'false' (or remove) to use the real Supabase project.
VITE_USE_MOCK_SUPABASE=true

# Required only when VITE_USE_MOCK_SUPABASE is not 'true'.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Mock-mode options (ignored unless VITE_USE_MOCK_SUPABASE=true) ────────────
# The fake Google sign-in still calls the REAL backend /User/google-login with this
# email, so it must be a user your BE knows about, otherwise login fails there.
# VITE_MOCK_GOOGLE_EMAIL=mentor.demo@habitevolve.dev
# VITE_MOCK_GOOGLE_NAME=Demo Mentor
